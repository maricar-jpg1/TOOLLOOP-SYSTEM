mily: Helvetica; color: var(--ge-adaptive-fg, #000000); line-height: 1.2; pointer-events: all; white-space: normal; word-wrap: normal; "><h3><strong>1. Code Changes</strong></h3><p>Developer pushes code or opens a Pull Request to <code>main</code>.</p></div></div></div></foreignObject><text x="87" y="262" fill="#000000" font-family="Helvetica" font-size="12px" text-anchor="middle" style="fill: var(--ge-adaptive-fg, #000000);"><tspan x="87" y="262">1. Code Changes</tspan><tspan x="87" y="276">Developer pushes code</tspan><tspan x="87" y="290">or opens a Pull</tspan><tspan x="87" y="304">Request to main.</tspan></text></switch></g></g></g><g data-cell-id="g7tFxd_WzkdhwEr6Olz0-11"><g transform="translate(0.5,0.5)"><rect x="172" y="212" width="130" height="135" fill="#fad9d5" stroke="#ae4132" pointer-events="all" style="fill: light-dark(rgb(250, 217, 213), rgb(68, 39, 36)); stroke: light-dark(rgb(174, 65, 50), rgb(236, 143, 130));"/></g><g><g><switch><foreignObject style="overflow: visible; text-align: left;" pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 128px; height: 1px; padding-top: 279px; margin-left: 173px;"><div style="box-sizing: border-box; font-size: 0; text-align: center; color: #000000; "><div style="display: inline-block; font-size: 12px; font-family: Helvetica; color: var(--ge-adaptive-fg, #000000); line-height: 1.2; pointer-events: all; white-space: normal; word-wrap: normal; "><h3><strong>2. GitHub</strong></h3><p>Source code is stored and triggers the CI workflow.</p><p><br /></p></div></div></div></foreignObject><text x="237" y="255" fill="#000000" font-family="Helvetica" font-size="12px" text-anchor="middle" style="fill: var(--ge-adaptive-fg, #000000);"><tspan x="237" y="255">2. GitHub</tspan><tspan x="237" y="269">Source code is stored</tspan><tspan x="237" y="283">and triggers the CI</tspan><tspan x="237" y="297">workflow.</tspan><tspan x="237" y="311"></tspan></text></switch></g></g></g><g data-cell-id="g7tFxd_WzkdhwEr6Olz0-13"><g transform="translate(0.5,0.5)"><rect x="732" y="402" width="140" height="60" fill="#d0cee2" stroke="#56517e" pointer-events="all" style="fill: light-dark(rgb(208, 206, 226), rgb(59, 57, 74)); stroke: light-dark(rgb(86, 81, 126), rgb(164, 160, 198));"/></g><g><g><switch><foreignObject style="overflow: visible; text-align: left;" pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 138px; height: 1px; padding-top: 432px; margin-left: 733px;"><div style="box-sizing: border-box; font-size: 0; text-align: center; color: #000000; "><div style="display: inline-block; font-size: 12px; font-family: Helvetica; color: var(--ge-adaptive-fg, #000000); line-height: 1.2; pointer-events: all; white-space: normal; word-wrap: normal; "><b>Deployment stops. Fix the errors and push again.</b></div></div></div></foreignObject><text x="802" y="422" fill="#000000" font-family="Helvetica" font-size="12px" text-anchor="middle" style="fill: var(--ge-adaptive-fg, #000000);"><tspan x="802" y="422">Deployment stops. Fix</tspan><tspan x="802" y="436">the errors and push</tspan><tspan x="802" y="450">again.</tspan></text></switch></g></g></g><g data-cell-id="g7tFxd_WzkdhwEr6Olz0-14"><g transform="translate(0.5,0.5)"><rect x="902" y="122" width="150" height="340" rx="22.5" ry="22.5" fill="#b1ddf0" stroke="#10739e" pointer-events="all" style="fill: light-dark(rgb(177, 221, 240), rgb(23, 61, 77)); stroke: light-dark(rgb(16, 115, 158), rgb(84, 169, 206));"/></g></g><g data-cell-id="g7tFxd_WzkdhwEr6Olz0-15"><g transform="translate(0.5,0.5)"><rect x="922" y="144.5" width="120" height="75" fill="#d0cee2" stroke="#56517e" pointer-events="all" style="fill: light-dark(rgb(208, 206, 226), rgb(59, 57, 74)); stroke: light-dark(rgb(86, 81, 126), rgb(164, 160, 198));"/></g><g><g><switch><foreignObject style="overflow: visible; text-align: left;" pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 118px; height: 1px; padding-top: 182px; margin-left: 923px;"><div style="box-sizing: border-box; font-size: 0; text-align: center; color: #000000; "><div style="display: inline-block; font-size: 12px; font-family: Helvetica; color: var(--ge-adaptive-fg, #000000); line-height: 1.2; pointer-events: all; white-space: normal; word-wrap: normal; "><h3><strong><span style="font-size: 11px;">4. Deploy (CD)</span></strong></h3><p><span style="font-size: 11px;">Automatically deploys the updated application.</span></p></div></div></div></foreignObject><text x="982" y="165" fill="#000000" font-family="Helvetica" font-size="12px" text-anchor="middle" style="fill: var(--ge-adaptive-fg, #000000);"><tspan x="982" y="165">4. Deploy (CD)</tspan><tspan x="982" y="179">Automatically deploys</tspan><tspan x="982" y="193">the updated</tspan><tspan x="982" y="207">application.</tspan></text></switch></g></g></g><g data-cell-id="g7tFxd_WzkdhwEr6Olz0-18"><g transform="translate(0.5,0.5)"><rect x="907" y="232" width="140" height="75" fill="#d0cee2" stroke="#56517e" pointer-events="all" style="fill: light-dark(rgb(208, 206, 226), rgb(59, 57, 74)); stroke: light-dark(rgb(86, 81, 126), rgb(164, 160, 198));"/></g><g><g><switch><foreignObject style="overflow: visible; text-align: left;" pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 138px; height: 1px; padding-top: 270px; margin-left: 908px;"><div style="box-sizing: border-box; font-size: 0; text-align: center; color: #000000; "><div style="display: inline-block; font-size: 12px; font-family: Helvetica; color: var(--ge-adaptive-fg, #000000); line-height: 1.2; pointer-events: all; white-space: normal; word-wrap: normal; "><p><strong><span style="font-size: 9px;">Backend</span></strong></p><p><strong><span style="font-size: 9px;">Render</span></strong></p><p><strong><span style="font-size: 9px;">Backend API (.NET 10)</span></strong></p></div></div></div></foreignObject><text x="977" y="259" fill="#000000" font-family="Helvetica" font-size="12px" text-anchor="middle" style="fill: var(--ge-adaptive-fg, #000000);"><tspan x="977" y="259">Backend</tspan><tspan x="977" y="273">Render</tspan><tspan x="977" y="287">Backend API (.NET 10)</tspan></text></switch></g></g></g><g data-cell-id="g7tFxd_WzkdhwEr6Olz0-19"><g transform="translate(0.5,0.5)"><rect x="907" y="327" width="140" height="100" fill="#d0cee2" stroke="#56517e" pointer-events="all" style="fill: light-dark(rgb(208, 206, 226), rgb(59, 57, 74)); stroke: light-dark(rgb(86, 81, 126), rgb(164, 160, 198));"/></g><g><g><switch><foreignObject style="overflow: visible; text-align: left;" pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 138px; height: 1px; padding-top: 377px; margin-left: 908px;"><div style="box-sizing: border-box; font-size: 0; text-align: center; color: #000000; "><div style="display: inline-block; font-size: 12px; font-family: Helvetica; color: var(--ge-adaptive-fg, #000000); line-height: 1.2; pointer-events: all; white-space: normal; word-wrap: normal; "><p><strong>Frontend </strong></p><p><strong>Netlify </strong></p><p><strong>Frontend ( React + Vite)</strong></p></div></div></div></foreignObject><t