: 308px; height: 1px; padding-top: 412px; margin-left: 363px;"><div style="box-sizing: border-box; font-size: 0; text-align: center; color: #000000; "><div style="display: inline-block; font-size: 12px; font-family: Helvetica; color: var(--ge-adaptive-fg, #000000); line-height: 1.2; pointer-events: all; white-space: normal; word-wrap: normal; "><h3><p><strong><span style="font-size: 14px;">Frontend (React + Vite)</span></strong></p><ul><li><p><span style="font-size: 14px;">Install dependencies</span></p></li><li><p><span style="font-size: 14px;">Run frontend tests</span></p></li><li><p><span style="font-size: 14px;">Build the application</span></p></li></ul></h3></div></div></div></foreignObject><text x="517" y="402" fill="#000000" font-family="Helvetica" font-size="12px" text-anchor="middle" style="fill: var(--ge-adaptive-fg, #000000);"><tspan x="517" y="402">Frontend (React + Vite)</tspan><tspan x="517" y="416">Install dependenciesRun frontend testsBuild the</tspan><tspan x="517" y="430">application</tspan></text></switch></g></g></g><g data-cell-id="g7tFxd_WzkdhwEr6Olz0-9"><g transform="translate(0.5,0.5)"><path d="M 802 232 L 887 299.5 L 802 367 L 717 299.5 Z" fill="#fad9d5" stroke="#ae4132" stroke-miterlimit="10" pointer-events="all" style="fill: light-dark(rgb(250, 217, 213), rgb(68, 39, 36)); stroke: light-dark(rgb(174, 65, 50), rgb(236, 143, 130));"/></g><g><g><switch><foreignObject style="overflow: visible; text-align: left;" pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 168px; height: 1px; padding-top: 300px; margin-left: 718px;"><div style="box-sizing: border-box; font-size: 0; text-align: center; color: #000000; "><div style="display: inline-block; font-size: 12px; font-family: Helvetica; color: var(--ge-adaptive-fg, #000000); line-height: 1.2; pointer-eve